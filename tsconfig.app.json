{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "outDir": "./dist",
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@attention": ["packages/attention/src/index.ts"],
      "@pretext-layout": ["packages/pretext-layout/src/index.ts"],
      "@content-model": ["packages/content-model/src/index.ts"],
      "@layout-region": ["packages/layout-region/src/index.ts"]
    }
  },
  "include": ["src", "packages/*/src", "vite.config.ts"]
}

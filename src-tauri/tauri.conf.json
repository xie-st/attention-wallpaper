{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AttentionWallpaper",
  "version": "0.1.0",
  "identifier": "com.attentionwallpaper.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "editor",
        "title": "注意力壁纸",
        "width": 1080,
        "height": 740,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "decorations": true
      },
      {
        "label": "overlay",
        "url": "index.html?window=overlay",
        "title": "Overlay",
        "width": 1260,
        "height": 792,
        "resizable": false,
        "center": false,
        "x": 0,
        "y": 0,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "注意力壁纸 — 把目标和句子融入壁纸的低干扰区域",
    "longDescription": "An independent, local-first Windows desktop app that blends user-authored goals, questions, and sentences into the wallpaper along low-distraction regions."
  },
  "plugins": {}
}
